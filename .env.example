# 可选环境变量示例（复制为 .env 或直接 export；本项目不自动读取 .env 文件）

# 凭据目录覆盖（默认 ~/.config/spotify-full）
# SPOTIFY_FULL_CONFIG_DIR=/path/to/config-dir

# 后端选择（默认 oauth；cookie = 网页播放器内部接口模式，见 README「cookie 模式」）
# SPOTIFY_FULL_BACKEND=cookie

# cookie 模式单次运行写操作上限（默认 50）
# SPOTIFY_FULL_COOKIE_MAX_WRITES=50

# cookie 模式 TOTP 密钥社区源覆盖（默认用内置的社区仓库地址）
# SPOTIFY_FULL_TOTP_SECRETS_URL=https://example.com/secretDict.json
# 禁止运行时拉取 TOTP 密钥（只用本地缓存 + 内置兜底）
# SPOTIFY_FULL_TOTP_NO_FETCH=1

# 自带无头浏览器登录模块的 Chromium 路径覆盖（默认自动探测）
# SPOTIFY_FULL_CHROMIUM=/path/to/chromium
